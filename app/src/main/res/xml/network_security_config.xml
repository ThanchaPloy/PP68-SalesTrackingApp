<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: HTTPS only, system CAs only. The debug source set replaces this file with a
         permissive version for LAN work; keep the two in sync when either one changes. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>